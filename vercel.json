{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "astro build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/prompt-of-the-day",
      "destination": "/prompt-of-the-day.html"
    },
    {
      "source": "/prompt-of-the-day/",
      "destination": "/prompt-of-the-day.html"
    },
    {
      "source": "/ar/prompt-of-the-day",
      "destination": "/prompt-of-the-day.html"
    },
    {
      "source": "/ar/prompt-of-the-day/",
      "destination": "/prompt-of-the-day.html"
    },
    {
      "source": "/time-saved",
      "destination": "/time-saved.html"
    },
    {
      "source": "/time-saved/",
      "destination": "/time-saved.html"
    },
    {
      "source": "/ar/time-saved",
      "destination": "/time-saved.html"
    },
    {
      "source": "/ar/time-saved/",
      "destination": "/time-saved.html"
    },
    {
      "source": "/certificate",
      "destination": "/certificate.html"
    },
    {
      "source": "/certificate/",
      "destination": "/certificate.html"
    },
    {
      "source": "/ar/certificate",
      "destination": "/certificate.html"
    },
    {
      "source": "/ar/certificate/",
      "destination": "/certificate.html"
    },
    {
      "source": "/prompt-grader",
      "destination": "/prompt-grader.html"
    },
    {
      "source": "/prompt-grader/",
      "destination": "/prompt-grader.html"
    },
    {
      "source": "/ar/prompt-grader",
      "destination": "/prompt-grader.html"
    },
    {
      "source": "/ar/prompt-grader/",
      "destination": "/prompt-grader.html"
    },
    {
      "source": "/ai-tool-quiz",
      "destination": "/ai-tool-quiz.html"
    },
    {
      "source": "/ai-tool-quiz/",
      "destination": "/ai-tool-quiz.html"
    },
    {
      "source": "/ar/ai-tool-quiz",
      "destination": "/ai-tool-quiz.html"
    },
    {
      "source": "/ar/ai-tool-quiz/",
      "destination": "/ai-tool-quiz.html"
    },
    {
      "source": "/prompt-library",
      "destination": "/prompt-library.html"
    },
    {
      "source": "/prompt-library/",
      "destination": "/prompt-library.html"
    },
    {
      "source": "/ar/prompt-library",
      "destination": "/prompt-library.html"
    },
    {
      "source": "/ar/prompt-library/",
      "destination": "/prompt-library.html"
    },
    {
      "source": "/today",
      "destination": "/prompt-of-the-day.html"
    },
    {
      "source": "/today/",
      "destination": "/prompt-of-the-day.html"
    },
    {
      "source": "/ar/today",
      "destination": "/prompt-of-the-day.html"
    },
    {
      "source": "/ar/today/",
      "destination": "/prompt-of-the-day.html"
    },
    {
      "source": "/links",
      "destination": "/links.html"
    },
    {
      "source": "/links/",
      "destination": "/links.html"
    },
    {
      "source": "/lessons",
      "destination": "/lessons/index.html"
    },
    {
      "source": "/finance",
      "destination": "/finance/index.html"
    },
    {
      "source": "/microsoft-365",
      "destination": "/microsoft-365/index.html"
    },
    {
      "source": "/tools",
      "destination": "/tools/index.html"
    },
    {
      "source": "/glossary",
      "destination": "/glossary/index.html"
    },
    {
      "source": "/my-prompts",
      "destination": "/my-prompts/index.html"
    },
    {
      "source": "/lessons/:slug",
      "destination": "/lessons/:slug/index.html"
    },
    {
      "source": "/ar/lessons",
      "destination": "/ar/lessons/index.html"
    },
    {
      "source": "/ar/finance",
      "destination": "/ar/finance/index.html"
    },
    {
      "source": "/ar/microsoft-365",
      "destination": "/ar/microsoft-365/index.html"
    },
    {
      "source": "/ar/tools",
      "destination": "/ar/tools/index.html"
    },
    {
      "source": "/ar/glossary",
      "destination": "/ar/glossary/index.html"
    },
    {
      "source": "/ar/my-prompts",
      "destination": "/ar/my-prompts/index.html"
    },
    {
      "source": "/ar/lessons/:slug",
      "destination": "/ar/lessons/:slug/index.html"
    },
    {
      "source": "/ar",
      "destination": "/ar/index.html"
    },
    {
      "source": "/portrait-720.webp",
      "destination": "/media/portrait-720.webp"
    },
    {
      "source": "/portrait-1200.webp",
      "destination": "/media/portrait-1200.webp"
    },
    {
      "source": "/avatar-160.webp",
      "destination": "/media/avatar-160.webp"
    }
  ]
}
