{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/assets/:file",
      "destination": "/:file"
    },
    {
      "source": "/media/og/:file",
      "destination": "/og-:file"
    },
    {
      "source": "/media/:file",
      "destination": "/:file"
    },
    {
      "source": "/ar",
      "destination": "/ar.html"
    },
    {
      "source": "/ar/",
      "destination": "/ar.html"
    },
    {
      "source": "/lessons",
      "destination": "/lessons.html"
    },
    {
      "source": "/lessons/",
      "destination": "/lessons.html"
    },
    {
      "source": "/ar/lessons",
      "destination": "/ar-lessons.html"
    },
    {
      "source": "/ar/lessons/",
      "destination": "/ar-lessons.html"
    },
    {
      "source": "/glossary",
      "destination": "/glossary.html"
    },
    {
      "source": "/glossary/",
      "destination": "/glossary.html"
    },
    {
      "source": "/ar/glossary",
      "destination": "/ar-glossary.html"
    },
    {
      "source": "/ar/glossary/",
      "destination": "/ar-glossary.html"
    },
    {
      "source": "/lessons/:slug(check-facts-and-numbers|emails-in-english-and-arabic|excel-formulas-and-cleanup|fix-a-weak-answer|summarize-documents-and-meetings|use-ai-safely)",
      "destination": "/lesson-:slug.html"
    },
    {
      "source": "/lessons/:slug(check-facts-and-numbers|emails-in-english-and-arabic|excel-formulas-and-cleanup|fix-a-weak-answer|summarize-documents-and-meetings|use-ai-safely)/",
      "destination": "/lesson-:slug.html"
    },
    {
      "source": "/ar/lessons/:slug(check-facts-and-numbers|emails-in-english-and-arabic|excel-formulas-and-cleanup|fix-a-weak-answer|summarize-documents-and-meetings|use-ai-safely)",
      "destination": "/ar-lesson-:slug.html"
    },
    {
      "source": "/ar/lessons/:slug(check-facts-and-numbers|emails-in-english-and-arabic|excel-formulas-and-cleanup|fix-a-weak-answer|summarize-documents-and-meetings|use-ai-safely)/",
      "destination": "/ar-lesson-:slug.html"
    }
  ]
}
