---
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LessonCard from './LessonCard.astro';
import Newsletter from './Newsletter.astro';
import ContinueCard from './ContinueCard.astro';
import { T, TRACKS, START, FREE_TOOLS, SITE, SOCIALS, fill, pre, type Lang } from '../i18n';
import data from '../data/site-data.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang];
const h = t.home;
const p = pre(lang);
const lessons = (await getCollection('lessons', l => l.data.lang === lang)).sort((a, b) => a.data.number - b.data.number);
const bySlug = Object.fromEntries(lessons.map(l => [l.data.slug, l]));
const FEATURED = ['set-up-chatgpt-for-work', 'claude-projects', 'prompt-patterns', 'summarize-documents-and-meetings', 'excel-formulas-and-cleanup', 'month-end-close-with-ai'];
const counts = Object.fromEntries(Object.keys(TRACKS).map(k => [k, lessons.filter(l => l.data.track === k).length]));
const faq = (data as any)[lang].faq;
const TOOL_ICON: Record<string, string> = { '/prompt-of-the-day': 'calendar-check', '/prompt-grader': 'gauge', '/ai-tool-quiz': 'compass', '/time-saved': 'hourglass-medium', '/prompt-library': 'books' };
const path = lang === 'ar' ? '/ar/' : '/';
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: t.siteName, url: SITE + path, inLanguage: lang, description: h.description },
  { '@context': 'https://schema.org', '@type': 'Person', name: 'Ahmed Hussein', jobTitle: lang === 'ar' ? 'محاسب' : 'Accountant', address: { '@type': 'PostalAddress', addressLocality: 'Riyadh', addressCountry: 'SA' }, url: SITE + path, image: SITE + '/media/portrait-720.webp', sameAs: SOCIALS.filter(s => s.id !== 'whatsapp').map(s => s.href) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.items.map((i: any) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a.replace(/<[^>]+>/g, '') } })) },
];
const startSteps = START.map((s, i) => ({ ...s, href: i === 0 ? '#builder' : `${p}/lessons/${s.slug}/`, minutes: i === 0 ? 5 : bySlug[s.slug]?.data.minutes }));
---
<Base lang={lang} title={h.title} description={h.description} path={path} jsonld={jsonld} intro>
  <Fragment slot="head"><link rel="preload" as="image" href="/media/room-poster.webp" /></Fragment>

  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="kicker fade-up" style="--d:var(--intro-d)">{h.kicker}</p>
        <h1 id="hero-h" class="rise" style="--d:calc(var(--intro-d) + .1s)">{h.h1.split(' ').map((w, i) => <><span class="w" style={`--i:${i}`}>{w}</span>{' '}</>)}</h1>
        <p class="lede fade-up" style="--d:calc(var(--intro-d) + .55s)">{h.lead}</p>
        <div class="hero__cta fade-up" style="--d:calc(var(--intro-d) + .7s)"><a class="btn btn--accent" href="#builder">{h.cta1}</a><a class="btn btn--line" href="#start">{h.cta2}</a></div>
        <div class="hero__continue"><ContinueCard lang={lang} /></div>
      </div>
      <div class="room fade-up" id="room" style="--d:calc(var(--intro-d) + .3s)">
        <img class="room__poster" src="/media/room-poster.webp" alt={h.scene} width="900" height="1000" fetchpriority="high" />
        <div class="room__times" role="group" aria-label={h.timesLabel}>
          {h.times.map((n, i) => <button type="button" data-time={i} aria-pressed={i === 1 ? 'true' : 'false'}>{n}</button>)}
        </div>
        <p class="room__meter" aria-hidden="true"><span id="room-light">100%</span></p>
      </div>
    </div>
  </section>

  <section class="block builder-sec" id="builder" aria-labelledby="builder-h">
    <div class="wrap">
      <div class="head" data-reveal><h2 id="builder-h">{h.bH}</h2><p>{h.bP}</p></div>
      <div class="builder" data-t={JSON.stringify({ ex: h.ex, parts: h.parts, lightOf: h.lightOf, hintMiss: h.hintMiss, hintFull: h.hintFull, copied: h.copied, selected: h.selected, empty: h.empty, stepDone: h.stepDone })}>
        <div class="btabs" role="tablist" aria-label={h.examplesLabel}>
          {h.tabs.map((n, i) => <button class="btab" role="tab" type="button" data-ex={i} aria-selected={i === 0 ? 'true' : 'false'} aria-controls="b-fields">{n}</button>)}
        </div>
        <div class="fields" id="b-fields" role="tabpanel">
          {h.labels.map((l, i) => (
            <div class="field"><label for={`bf${i}`}><i class={`dot dot--${i}`} aria-hidden="true"></i>{l}</label><textarea id={`bf${i}`} rows="2">{h.ex[0][i]}</textarea></div>
          ))}
        </div>
        <div class="out">
          <p class="kicker">{h.yours}</p>
          <div class="preview" id="b-preview"></div>
          <div class="meter">
            <div class="stars" aria-hidden="true">{[0, 1, 2, 3].map(i => <i class={`star star--${i}`}></i>)}</div>
            <p><b id="b-score">100%</b> <span>{h.lightOf}</span></p>
          </div>
          <p class="hint" id="b-hint" role="status"></p>
          <div class="brow"><button class="btn btn--accent" type="button" id="b-copy">{h.copy}</button><a class="btn btn--line" href="#room">{h.seeLight}</a></div>
          <p class="hint" id="b-copied" role="status"></p>
        </div>
      </div>
    </div>
  </section>

  <section class="block start-sec" id="start" aria-labelledby="start-h">
    <div class="wrap">
      <div class="head" data-reveal><h2 id="start-h">{h.startH}</h2><p>{h.startP}</p></div>
      <ol class="arches" role="list" data-reveal-stagger>
        {startSteps.map((s, i) => (
          <li class="arch" data-step={i} data-slug={s.slug}>
            <span class="arch__n" aria-hidden="true"><span class="arch__num">{i + 1}</span><Icon name="check" weight="bold" class="arch__tick" /></span>
            <h3><a href={s.href}>{s[lang][0]}</a></h3>
            <p>{s[lang][1]}</p>
            <span class="arch__min mono">{fill(t.lesson.read, { n: s.minutes ?? 7 })}</span>
          </li>
        ))}
      </ol>
      <p class="cert-line" id="cert-line" data-t={JSON.stringify({ progress: h.progress, next: h.next, certLine: h.certLine, certGo: h.certGo, certReady: h.certReady, certGet: h.certGet })} data-cert={`${p}/certificate`}>
        <span>{h.certLine}</span> <a href={`${p}/certificate`}>{h.certGo}</a>
      </p>
    </div>
  </section>

  <section class="block" id="tracks" aria-labelledby="tracks-h">
    <div class="wrap">
      <div class="head" data-reveal><h2 id="tracks-h">{h.tracksH}</h2><p>{h.tracksP}</p></div>
      <div class="courts" data-reveal-stagger>
        {Object.entries(TRACKS).map(([k, tr]) => (
          <article class="court" data-tilt>
            {/* Each track is the same room at a different hour: noon, dawn, dusk. */}
            <img class="court__img" src={`/media/court-${({ 'ai-for-work': 'noon', finance: 'dawn', 'microsoft-365': 'dusk' } as Record<string, string>)[k]}.webp`} alt="" width="960" height="720" loading="lazy" decoding="async" />
            <div class="court__body">
            <span class="mono court__n">{fill(t.list.count, { n: counts[k] })}</span>
            <h3><a href={p + tr.href}>{tr[lang]}</a></h3>
            <p>{(h.trackText as any)[k]}</p>
            <span class="court__go" aria-hidden="true">{h.open} <Icon name="arrow-right" class="icon icon-flip" /></span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="block" id="lessons" aria-labelledby="latest-h" style="padding-top:0">
    <div class="wrap">
      <div class="head head--row" data-reveal><div><h2 id="latest-h">{h.latestH}</h2><p>{h.latestP}</p></div><a class="btn btn--line" href={`${p}/lessons/`}>{h.allLessons}</a></div>
      <div class="cards" data-reveal-stagger>{FEATURED.map(s => bySlug[s] && <LessonCard lesson={bySlug[s]} lang={lang} />)}</div>
    </div>
  </section>

  <section class="block tools-sec" aria-labelledby="tools-h">
    <div class="wrap tools-grid">
      <div class="head" data-reveal><h2 id="tools-h">{h.toolsH}</h2><p>{h.toolsP}</p></div>
      <ul class="tool-list" role="list" data-reveal-stagger>
        {FREE_TOOLS.map(ft => { const [n, d] = lang === 'ar' ? ft.arT : ft.en; return <li><a href={lang === 'ar' ? ft.ar : ft.href}><Icon name={TOOL_ICON[ft.href] || 'wrench'} class="tool-list__i" /><span class="tool-list__n">{n}</span><span class="tool-list__d">{d}</span></a></li>; })}
      </ul>
    </div>
  </section>

  <section class="block" id="about" aria-labelledby="about-h">
    <div class="wrap about">
      <figure data-reveal><img src="/media/portrait-720.webp" alt={h.photo} width="720" height="703" loading="lazy" decoding="async" /></figure>
      <div>
        <h2 id="about-h">{h.aboutH}</h2>
        {h.about.map(x => <p>{x}</p>)}
        <p class="about__note">{h.aboutNote}</p>
      </div>
    </div>
  </section>

  <Newsletter lang={lang} />

  <section class="block" id="faq" aria-labelledby="faq-h">
    <div class="wrap faq">
      <h2 id="faq-h">{faq.title}</h2>
      <div class="faq__list" data-reveal-stagger>{faq.items.map((i: any) => <details><summary>{i.q}</summary><div set:html={i.a} /></details>)}</div>
    </div>
  </section>
</Base>

<style>
  /* hero */
  .hero{padding-block:clamp(24px,4vw,48px) clamp(48px,7vw,88px)}
  .hero__grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.8fr);gap:clamp(24px,4vw,56px);align-items:center}
  .hero h1{font-size:clamp(2.5rem,1.2rem + 3vw,4rem);margin-block:12px 20px}
  .hero .lede{max-width:34rem}
  .hero__cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
  .room{position:relative;aspect-ratio:.8;border-radius:220px 220px 18px 18px;overflow:hidden;border:1px solid var(--line-2);background:#16100c;max-width:100%}
  .room :global(canvas),.room__poster{position:absolute;inset:0;width:100%!important;height:100%!important;object-fit:cover}
  .room__poster{transition:opacity .6s}
  .room.is-live .room__poster{opacity:0}
  .room__times{position:absolute;inset-inline:12px;bottom:14px;display:flex;justify-content:center;flex-wrap:wrap;gap:6px}
  .room__times button{min-height:38px;padding:0 14px;border-radius:999px;border:1px solid #6b5139;background:#16100ccc;color:#f3ece3;font-size:.88rem;cursor:pointer;backdrop-filter:blur(6px)}
  .room__times button[aria-pressed=true]{background:#f2a33a;border-color:#f2a33a;color:#1d1206}
  .room:not(.is-live) .room__times{display:none}
  .room__meter{position:absolute;top:18%;inset-inline-end:10%;font:500 .8rem var(--mono);color:#f3ece3;background:#16100ccc;border:1px solid #6b5139;border-radius:999px;padding:4px 10px;opacity:0;transition:opacity .4s}
  .room.is-dim .room__meter{opacity:1}
  @media (max-width:880px){.hero__grid{grid-template-columns:minmax(0,1fr)}.room{aspect-ratio:1;max-height:70vh;width:100%}}

  /* builder */
  .builder{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px;background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:clamp(16px,3vw,28px)}
  .btabs{display:flex;flex-wrap:wrap;gap:6px;grid-column:1/-1}
  .btab{min-height:40px;padding:0 16px;border-radius:999px;border:1px solid var(--line-2);background:transparent;cursor:pointer;font-size:.92rem}
  .btab[aria-selected=true]{background:var(--text);color:var(--bg);border-color:var(--text)}
  .fields{display:grid;gap:12px}
  .field{display:grid;gap:6px}
  .field label{display:flex;align-items:center;gap:8px;font-weight:600;font-size:.94rem}
  .field textarea{min-height:64px;resize:vertical;border-radius:12px;border:1px solid var(--line-2);background:var(--bg);color:var(--text);padding:10px 12px;line-height:1.6}
  .field textarea:focus{border-color:var(--accent);outline:none}
  .dot,.star{display:inline-block;clip-path:polygon(99.0% 59.8%,81.8% 71.3%,77.8% 91.6%,57.5% 87.5%,40.2% 99.0%,28.7% 81.8%,8.4% 77.8%,12.5% 57.5%,1.0% 40.2%,18.2% 28.7%,22.2% 8.4%,42.5% 12.5%,59.8% 1.0%,71.3% 18.2%,91.6% 22.2%,87.5% 42.5%)}
  .dot{width:14px;height:14px}
  .dot--0,.star--0.on{background:var(--role)}.dot--1,.star--1.on{background:var(--task)}.dot--2,.star--2.on{background:var(--context)}.dot--3,.star--3.on{background:var(--format)}
  .out{display:grid;gap:14px;align-content:start}
  .preview{background:var(--bg);border:1px solid var(--line);border-radius:16px;padding:18px;line-height:1.85;min-height:180px}
  .preview :global(.r){color:var(--role)}.preview :global(.t){color:var(--task)}.preview :global(.c){color:var(--context)}.preview :global(.f){color:var(--format)}
  .meter{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
  .meter b{font:600 2.2rem/1 var(--display);font-variant-numeric:tabular-nums;color:var(--text)}
  .meter span{color:var(--muted)}
  .stars{display:flex;gap:8px}
  .star{width:34px;height:34px;background:var(--line);transition:background .3s}
  .hint{color:var(--text-2);font-size:.95rem;min-height:1.5em}
  .brow{display:flex;flex-wrap:wrap;gap:10px}
  @media (max-width:860px){.builder{grid-template-columns:minmax(0,1fr)}}

  /* start here */
  .start-sec{background:var(--surface);border-block:1px solid var(--line)}
  .arches{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px}
  .arch{position:relative;border:1px solid var(--line);border-radius:999px 999px 12px 12px;padding:28px 14px 18px;text-align:center;display:grid;gap:8px;align-content:start;justify-items:center;background:linear-gradient(180deg,var(--surface-2),var(--bg))}
  .arch h3{font-size:1.08rem}
  .arch h3 a{text-decoration:none}
  .arch h3 a::after{content:"";position:absolute;inset:0;border-radius:inherit}
  .arch:has(a:focus-visible){outline:2px solid var(--accent);outline-offset:3px}
  .arch h3 a:focus-visible{outline:none}
  .arch p{color:var(--muted);font-size:.9rem}
  .arch__n{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--line-2);font:600 1rem var(--mono);color:var(--accent-text)}
  .arch__tick{width:18px;height:18px;display:none}
  .arch__min{font-size:.78rem;color:var(--muted)}
  .arch.is-done .arch__n{background:var(--ok);border-color:var(--ok);color:var(--bg)}
  .arch.is-done .arch__num{display:none}.arch.is-done .arch__tick{display:block}
  .arch.is-next{border-color:var(--accent)}
  .arch.is-next .arch__n{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
  .cert-line{margin-top:22px;padding:14px 18px;border:1px dashed var(--line-2);border-radius:12px;color:var(--text-2);display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center}
  .cert-line :global(a){color:var(--accent-text);font-weight:600}
  .cert-line :global(.next){display:inline-flex;align-items:center;min-height:40px;padding:0 16px;border-radius:999px;background:var(--accent);color:var(--accent-ink);text-decoration:none}
  @media (max-width:980px){.arches{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media (max-width:560px){.arches{grid-template-columns:repeat(2,minmax(0,1fr))}.arch{padding-top:22px}}

  /* courtyards */
  /* Bento: the main track is a tall tile; the other two stack beside it with their picture at the side. */
  .courts{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);grid-template-rows:auto auto;gap:16px}
  .court{position:relative;border-radius:var(--radius);display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1fr);background:var(--surface);border:1px solid var(--line);overflow:hidden}
  .court:first-child{grid-row:span 2;grid-template-columns:minmax(0,1fr);grid-template-rows:minmax(0,1fr) auto}
  .court__img{width:100%;height:100%;min-height:180px;object-fit:cover;display:block;transition:transform var(--spring-t,.5s) var(--spring,ease)}
  .court:first-child .court__img{aspect-ratio:4/3;height:auto}
  .court:hover .court__img{transform:scale(1.04)}
  .court__body{padding:22px;display:grid;gap:10px;align-content:center}
  .court:first-child .court__body{padding:24px 26px 26px}
  .court h3{font-size:1.6rem}
  .court:first-child h3{font-size:clamp(1.8rem,1.3rem + 1vw,2.3rem)}
  .court h3 a{text-decoration:none}
  .court h3 a::after{content:"";position:absolute;inset:0}
  .court:has(a:focus-visible){outline:2px solid var(--accent);outline-offset:3px}
  .court h3 a:focus-visible{outline:none}
  .court:hover{border-color:var(--line-2)}
  .court p{color:var(--text-2)}
  .court__n{color:var(--tile-text);font-size:.85rem}
  .court__go{display:inline-flex;align-items:center;gap:6px;color:var(--accent-text);font-weight:600}
  .court__go .icon{width:18px;height:18px}
  @media (max-width:860px){.courts{grid-template-columns:minmax(0,1fr)}.court,.court:first-child{grid-row:auto;grid-template-columns:minmax(0,1fr)}.court__img{aspect-ratio:16/9;height:auto;min-height:0}}

  /* tools */
  .tools-sec{background:var(--surface);border-block:1px solid var(--line)}
  /* Five tools in one row of tiles; on smaller screens the row scrolls sideways and snaps. */
  .tools-grid{display:grid;gap:28px}
  .tool-list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px}
  .tool-list a{display:grid;align-content:start;gap:6px;height:100%;padding:20px 18px 22px;border-radius:var(--radius);border:1px solid var(--line);background:var(--bg);text-decoration:none;transition:border-color .25s,transform var(--spring-fast,.4s) var(--spring,ease)}
  .tool-list a:hover{border-color:var(--accent);transform:translateY(-3px)}
  .tool-list__i{width:30px;height:30px;color:var(--accent-text);margin-bottom:6px}
  .tool-list__n{font:600 1.15rem/1.3 var(--display)}
  .tool-list__d{color:var(--text-2);font-size:.92rem}
  .tool-list a:hover .tool-list__n{color:var(--accent-text)}
  @media (max-width:1100px){.tool-list{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:minmax(230px,42%);overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:10px;scrollbar-width:thin}.tool-list li{scroll-snap-align:start}}
  @media (max-width:560px){.tool-list{grid-auto-columns:78%}}

  .hero__continue{margin-top:22px}
  .hero__continue:has(> [hidden]){display:none}
  /* about */
  .about{display:grid;grid-template-columns:minmax(0,320px) minmax(0,1fr);gap:clamp(24px,5vw,64px);align-items:center}
  .about img{width:100%;border-radius:180px 180px 14px 14px;border:1px solid var(--line-2);background:var(--surface-2)}
  .about h2{font-size:clamp(2rem,1.3rem + 2vw,3rem);margin-bottom:6px}
  .about p{color:var(--text-2);margin-top:12px;max-width:38rem}
  .about__note{display:inline-block;font-size:.9rem;color:var(--muted)!important;border:1px solid var(--line);border-radius:999px;padding:4px 14px}
  @media (max-width:760px){.about{grid-template-columns:minmax(0,1fr)}.about figure{max-width:260px}}

  /* faq */
  /* Stacked: question list under its heading, in a readable column. */
  .faq{display:grid;gap:24px;max-width:820px}
  .faq h2{font-size:clamp(2rem,1.3rem + 2vw,3rem)}
  .faq__list{border-top:1px solid var(--line)}
  .faq details{border-bottom:1px solid var(--line)}
  .faq summary{cursor:pointer;padding:18px 4px;font-weight:600;list-style:none;display:flex;justify-content:space-between;gap:16px}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary::after{content:"+";color:var(--accent-text);font-size:1.3rem;line-height:1}
  .faq details[open] summary::after{content:"−"}
  .faq details div{padding:0 4px 18px;color:var(--text-2)}

  /* motion hooks */
  .hero{--intro-d:.15s}
  :global(html.intro) .hero{--intro-d:1.2s}
  :global(.motion) .fade-up{animation:hero-in .9s var(--ease-out) both;animation-delay:var(--d,0s)}
  @keyframes hero-in{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
  :global(.motion) .room.fade-up{animation-name:room-in;animation-duration:1.3s}
  @keyframes room-in{from{opacity:0;transform:translateY(30px) scale(.96);filter:brightness(.4)}to{opacity:1;transform:none;filter:none}}
  .room.flash::after{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(60% 50% at 50% 60%,rgb(255 217 160 / .55),transparent 70%);animation:flash 1.2s ease-out both}
  @keyframes flash{from{opacity:1}to{opacity:0}}
  .star{transform-origin:center}
  .star.pop{animation:pop .6s var(--ease-spring)}
  @keyframes pop{0%{transform:scale(.4) rotate(-30deg)}60%{transform:scale(1.35) rotate(10deg)}100%{transform:none}}
  :global(.beam){position:fixed;left:-7px;top:-7px;width:14px;height:14px;border-radius:50%;z-index:94;pointer-events:none;box-shadow:0 0 14px 4px currentColor;color:var(--accent)}
  :global(.motion) .arch.is-next{animation:arch-glow 2.6s ease-in-out infinite}
  @keyframes arch-glow{0%,100%{box-shadow:0 0 0 0 rgb(242 163 58 / 0)}50%{box-shadow:0 0 34px -4px rgb(242 163 58 / .45)}}
  .arch.is-done .arch__n{animation:pop .6s var(--ease-spring)}
  .hero{position:relative;overflow:clip}
  .hero::before{content:"";position:absolute;inset:-20% -10% auto auto;width:70%;height:140%;pointer-events:none;z-index:-1;background:repeating-linear-gradient(115deg,transparent 0 60px,rgb(242 163 58 / .05) 60px 90px);-webkit-mask:radial-gradient(60% 60% at 70% 40%,#000,transparent);mask:radial-gradient(60% 60% at 70% 40%,#000,transparent)}
</style>

<script>
  // Homepage use cases. Talks to the learning domain for progress, to scenes for the room and
  // celebrations, and announces builder changes as events.
  import type { Room } from '../domains/scenes/lattice';
  import { motion } from '../domains/motion/kernel';
  import { emit, on } from '../domains/shared/events';
  import { completeStep1, startHere } from '../domains/learning/progress';
  import { burstFrom } from '../domains/scenes/starburst';

  // ---- the room ----
  const roomEl = document.getElementById('room')!;
  let room: Room | null = null;
  let pendingLight = 1;
  function canRun() {
    if (!motion.allowed) return false;
    // Phones that ask to save data, or have very little memory, keep the still picture.
    const nav = navigator as Navigator & { deviceMemory?: number; connection?: { saveData?: boolean } };
    if (nav.connection?.saveData || (nav.deviceMemory || 8) <= 2 || (nav.hardwareConcurrency || 8) <= 2) return false;
    try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch (e) { return false; }
  }
  if (canRun()) {
    // Wait until the page has loaded and the browser is idle, so the 3D never delays reading or tapping.
    const start = () => {
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        import('../domains/scenes/lattice').then(({ createRoom }) => { room = createRoom(roomEl); room.setLight(pendingLight); requestAnimationFrame(() => roomEl.classList.add('is-live')); }).catch(() => { room = null; });
      }, { rootMargin: '200px' });
      io.observe(roomEl);
    };
    const idle = () => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(start, { timeout: 2500 }) : setTimeout(start, 1200));
    if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true });
  }
  roomEl.querySelectorAll<HTMLButtonElement>('[data-time]').forEach(b => b.addEventListener('click', () => {
    roomEl.querySelectorAll('[data-time]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
    room?.setTime(+b.dataset.time!);
  }));
  on('builder:score-changed', ({ score }) => {
    pendingLight = score / 100;
    room?.setLight(pendingLight);
    roomEl.classList.toggle('is-dim', score < 100);
    document.getElementById('room-light')!.textContent = score + '%';
  });

  // ---- the prompt builder: each part lets a quarter of the light in ----
  const bEl = document.querySelector<HTMLElement>('.builder')!;
  const bt = JSON.parse(bEl.dataset.t!);
  const F = [0, 1, 2, 3].map(i => document.getElementById('bf' + i) as HTMLTextAreaElement);
  const stars = [...bEl.querySelectorAll<HTMLElement>('.star')];
  const esc = (s: string) => s.replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!));
  const cls = ['r', 't', 'c', 'f'];
  let prevOk = [true, true, true, true], prevScore = 100, quiet = true;

  // A bead of light flies from the field you just completed to its star.
  function beam(from: HTMLElement, to: HTMLElement, color: string) {
    if (!motion.allowed) return;
    const a = from.getBoundingClientRect(), b = to.getBoundingClientRect();
    const dot = document.createElement('i'); dot.className = 'beam'; dot.style.background = color; document.body.appendChild(dot);
    const x0 = a.left + 24, y0 = a.top + a.height / 2, x1 = b.left + b.width / 2, y1 = b.top + b.height / 2;
    dot.animate([
      { transform: `translate(${x0}px, ${y0}px) scale(.6)`, opacity: 0 },
      { transform: `translate(${(x0 + x1) / 2}px, ${Math.min(y0, y1) - 60}px) scale(1.4)`, opacity: 1, offset: .5 },
      { transform: `translate(${x1}px, ${y1}px) scale(.4)`, opacity: .2 },
    ], { duration: 700, easing: 'cubic-bezier(.16,1,.3,1)' }).onfinish = () => { dot.remove(); to.classList.remove('pop'); void to.offsetWidth; to.classList.add('pop'); };
  }

  function render() {
    const v = F.map(f => f.value.trim());
    const ok = v.map(x => x.length >= 10);
    const score = ok.filter(Boolean).length * 25;
    document.getElementById('b-preview')!.innerHTML = v.map((x, i) => x ? `<span class="${cls[i]}">${esc(x)}</span>` : '').filter(Boolean).join(' ') || `<span style="color:var(--muted)">${bt.empty}</span>`;
    document.getElementById('b-score')!.textContent = score + '%';
    stars.forEach((st, i) => st.classList.toggle('on', ok[i]));
    const miss = ok.indexOf(false);
    document.getElementById('b-hint')!.textContent = miss > -1 ? bt.hintMiss.replace('{p}', bt.parts[miss]) : bt.hintFull;
    if (!quiet) {
      ok.forEach((o, i) => { if (o && !prevOk[i]) { beam(F[i], stars[i], getComputedStyle(stars[i]).backgroundColor); emit('builder:part-filled', { index: i, from: F[i].getBoundingClientRect() }); } });
      if (score === 100 && prevScore < 100) { setTimeout(() => burstFrom(bEl.querySelector('.stars'), 26), 650); roomEl.classList.remove('flash'); void roomEl.offsetWidth; roomEl.classList.add('flash'); }
    }
    prevOk = ok; prevScore = score;
    emit('builder:score-changed', { score, parts: ok });
    return score;
  }
  function load(i: number) {
    bt.ex[i].forEach((t: string, k: number) => F[k].value = t);
    bEl.querySelectorAll('.btab').forEach((b, k) => b.setAttribute('aria-selected', String(k === i)));
    document.getElementById('b-copied')!.textContent = '';
    render();
  }
  bEl.querySelectorAll<HTMLButtonElement>('.btab').forEach(b => b.addEventListener('click', () => load(+b.dataset.ex!)));
  F.forEach(f => f.addEventListener('input', render));
  document.getElementById('b-copy')!.addEventListener('click', async () => {
    const out = document.getElementById('b-copied')!;
    const text = F.map(f => f.value.trim()).filter(Boolean).join(' ');
    try { await navigator.clipboard.writeText(text); out.textContent = bt.copied; }
    catch (e) { const r = document.createRange(); r.selectNodeContents(document.getElementById('b-preview')!); getSelection()!.removeAllRanges(); getSelection()!.addRange(r); out.textContent = bt.selected; }
    // Copying a complete prompt counts as step 1 of Start Here (the 4-part prompt).
    if (render() === 100 && completeStep1()) out.textContent += ' ' + bt.stepDone;
  });
  render();
  quiet = false;

  // ---- Start Here progress, read from the learning domain and repainted on every change ----
  function progress() {
    const { done, n, next } = startHere();
    const arches = [...document.querySelectorAll<HTMLElement>('.arch')];
    arches.forEach((a, i) => { a.classList.toggle('is-done', done[i]); a.classList.toggle('is-next', i === next); });
    const line = document.getElementById('cert-line')!;
    const lt = JSON.parse(line.dataset.t!);
    const link = (h: string, txt: string, c = '') => `<a ${c ? `class="${c}"` : ''} href="${h}">${esc(txt)}</a>`;
    if (n >= 6) line.innerHTML = `<span>${lt.certReady}</span> ${link(line.dataset.cert!, lt.certGet)}`;
    else if (next > -1) { const a = arches[next].querySelector('a')!; line.innerHTML = `<span><b>${lt.progress.replace('{n}', n)}</b></span> ${link(a.getAttribute('href')!, lt.next.replace('{t}', a.textContent!), 'next')} ${link(line.dataset.cert!, lt.certGo)}`; }
  }
  progress();
  on('learning:progress-changed', progress);
  on('learning:step-completed', () => burstFrom(document.querySelector('.arch[data-step="0"] .arch__n'), 22));
</script>
