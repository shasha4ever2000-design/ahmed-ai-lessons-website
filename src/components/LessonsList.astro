---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LessonCard from './LessonCard.astro';
import Newsletter from './Newsletter.astro';
import ContinueCard from './ContinueCard.astro';
import { T, SITE, fill, pre, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang], L = t.list, p = pre(lang);
const lessons = (await getCollection('lessons', l => l.data.lang === lang)).sort((a, b) => a.data.number - b.data.number);
const topics = [...new Set(lessons.map(l => l.data.topic))];
const path = `${p}/lessons/`;
const jsonld = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: L.title, url: SITE + path, inLanguage: lang,
  mainEntity: { '@type': 'ItemList', itemListElement: lessons.map((l, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE}${p}/lessons/${l.data.slug}/`, name: l.data.title })) } }];
---
<Base lang={lang} title={`${L.title} | ${t.siteName}`} description={L.lede} path={path} ogImage={`/media/og/${lang}-lessons.jpg`} jsonld={jsonld}>
  <div class="wrap">
    <header class="page-head">
      <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href={lang === 'ar' ? '/ar/' : '/'}>{t.lesson.home}</a></li><li aria-current="page">{L.title}</li></ol></nav>
      <h1>{L.title}</h1>
      <div class="head-row">
        <p class="lede">{L.lede}</p>
        <div class="ring" id="ring" role="img" aria-label={fill(L.doneN, { n: 0 })} data-t={L.doneN} style="--pct:0">
          <svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="52" /><circle class="ring__arc" cx="60" cy="60" r="52" pathLength="100" /></svg>
          <span class="ring__n mono" aria-hidden="true"><b id="ring-n">0</b>/{lessons.length}</span>
          <span class="ring__l" aria-hidden="true">{L.ring}</span>
        </div>
      </div>
      <ContinueCard lang={lang} compact />
    </header>
    <div class="chips" role="group" aria-label={L.filter}>
      <button class="chip" type="button" data-topic="" aria-pressed="true">{L.all}</button>
      {topics.map(tp => <button class="chip" type="button" data-topic={tp} aria-pressed="false">{tp}</button>)}
    </div>
    <p class="count mono" id="count" aria-live="polite" data-t={L.count}>{fill(L.count, { n: lessons.length })}</p>
    <div class="cards" style="padding-bottom:72px" data-reveal-stagger>
      <article class="card card--zero">
        <span class="card__topic">★</span>
        <h2 style="font-size:1.25rem"><a href={(lang === 'ar' ? '/ar/' : '/') + '#builder'}>{L.builder}</a></h2>
        <p>{L.builderP}</p>
      </article>
      {lessons.map(l => <LessonCard lesson={l} lang={lang} heading="h2" />)}
    </div>
  </div>
  <Newsletter lang={lang} compact />
</Base>
<style>
  .card--zero{background:var(--accent-soft);border-color:color-mix(in srgb,var(--accent) 45%,var(--line))}
  .card--zero :global(h2 a){text-decoration:none}
  .card--zero :global(h2 a)::after{content:"";position:absolute;inset:0}
  .head-row{display:flex;align-items:center;gap:24px;justify-content:space-between}
  .head-row .lede{flex:1}
  .ring{position:relative;flex:none;width:118px;height:118px;display:grid;place-items:center;text-align:center}
  .ring svg{position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg)}
  .ring circle{fill:none;stroke:var(--line);stroke-width:7}
  .ring.is-zero .ring__arc{opacity:0}
  .ring .ring__arc{stroke:var(--accent);stroke-linecap:round;stroke-dasharray:var(--pct) 100;transition:stroke-dasharray 1.4s var(--ease-out,ease) .3s}
  .ring__n{position:relative;font-size:.95rem;color:var(--text-2);margin-top:-12px}
  .ring__n b{font-size:1.7rem;color:var(--text);font-family:var(--display)}
  .ring__l{position:absolute;bottom:30px;font-size:.72rem;color:var(--text-2);text-transform:uppercase;letter-spacing:.05em}
  :global([dir=rtl]) .ring__l{letter-spacing:0}
  .page-head :global(.continue){margin-top:18px}
  @media (max-width:640px){.ring{width:96px;height:96px}.ring__n{margin-top:-10px}.ring__n b{font-size:1.35rem}.ring__l{bottom:22px;font-size:.62rem}.head-row{gap:14px}}
  .cards :global(.card h2){font-size:1.25rem}
  .cards :global(.card h2 a){text-decoration:none}
  .cards :global(.card h2 a)::after{content:"";position:absolute;inset:0;border-radius:inherit}
</style>
<script>
  import { doneLessons } from '../domains/learning/progress';
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const cards = [...document.querySelectorAll<HTMLElement>('.lesson-card')];
  const count = document.getElementById('count')!;
  const zero = document.querySelector<HTMLElement>('.card--zero')!;
  function apply(topic: string) {
    let n = 0;
    cards.forEach(c => { const show = !topic || c.dataset.topic === topic; c.hidden = !show; if (show) n++; });
    zero.hidden = !!topic;
    chips.forEach(ch => ch.setAttribute('aria-pressed', String(ch.dataset.topic === topic)));
    count.textContent = count.dataset.t!.replace('{n}', String(n));
  }
  chips.forEach(ch => ch.addEventListener('click', () => apply(ch.dataset.topic!)));
  const done = doneLessons();
  const n = cards.filter(c => done.includes(c.dataset.slug!)).length;
  // Progress ring: fills to the share of lessons finished on this device.
  const ring = document.getElementById('ring')!;
  ring.setAttribute('aria-label', ring.dataset.t!.replace('{n}', String(n)));
  document.getElementById('ring-n')!.textContent = String(n);
  ring.classList.toggle('is-zero', !n);
  requestAnimationFrame(() => ring.style.setProperty('--pct', String(Math.round((n / cards.length) * 100))));
</script>
