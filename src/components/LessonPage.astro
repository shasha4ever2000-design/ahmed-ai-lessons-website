---
import Icon from './Icon.astro';
import { topicIcon } from '../topicIcons';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Newsletter from './Newsletter.astro';
import LessonPromptTools from './LessonPromptTools.astro';
import TermPops from './TermPops.astro';
import TocSheet from './TocSheet.astro';
import Listen from './Listen.astro';
import AskSelection from './AskSelection.astro';

import { T, SITE, fill, pre, formatDate, type Lang } from '../i18n';

interface Props { entry: any; lang: Lang }
const { entry, lang } = Astro.props;
const d = entry.data;
const t = T[lang];
const L = t.lesson;
const R = t.resume;
const p = pre(lang);
const all = (await getCollection('lessons', l => l.data.lang === lang)).sort((a, b) => a.data.number - b.data.number);
const i = all.findIndex(l => l.data.slug === d.slug);
const prev = all[i - 1]?.data, next = all[i + 1]?.data;
// "Keep reading": up to three lessons from the same track (not the ones already in the pager),
// closest by number first; topped up from other tracks if the track is small.
const shown = new Set([d.slug, prev?.slug, next?.slug]);
const byDistance = (a: any, b: any) => Math.abs(a.data.number - d.number) - Math.abs(b.data.number - d.number);
const related = [
  ...all.filter(l => !shown.has(l.data.slug) && l.data.track === d.track).sort(byDistance),
  ...all.filter(l => !shown.has(l.data.slug) && l.data.track !== d.track).sort(byDistance),
].slice(0, 3);
const path = `${p}/lessons/${d.slug}/`;
const url = SITE + path;
const enc = encodeURIComponent;
const share = [
  ['WhatsApp', `https://wa.me/?text=${enc(d.title + ' ' + url)}`],
  ['LinkedIn', `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`],
  ['X', `https://x.com/intent/tweet?text=${enc(d.title)}&url=${enc(url)}`],
  ['Facebook', `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`],
];
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description, inLanguage: lang, datePublished: d.updated, dateModified: d.updated,
    author: { '@type': 'Person', name: 'Ahmed Hussein', url: SITE + (lang === 'ar' ? '/ar/' : '/') }, image: `${SITE}/media/og/${lang}-${d.slug}.jpg`, mainEntityOfPage: url, isAccessibleForFree: true,
    educationalLevel: d.level, timeRequired: `PT${d.minutes}M` },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: L.home, item: SITE + (lang === 'ar' ? '/ar/' : '/') },
    { '@type': 'ListItem', position: 2, name: L.all, item: `${SITE}${p}/lessons/` },
    { '@type': 'ListItem', position: 3, name: d.title, item: url } ] },
];
const doneBtn = `<span class="done-toggle__box" aria-hidden="true"></span><span class="done-toggle__label">${L.done}</span>`;
---
<Base lang={lang} title={`${d.title} | ${t.siteName}`} description={d.description} path={path} ogImage={`/media/og/${lang}-${d.slug}.jpg`} ogType="article" jsonld={jsonld} readBar>
  <article class="lesson wrap" aria-labelledby="lesson-title" data-slug={d.slug} data-track={d.track} data-read-scope>
    <nav class="crumbs" aria-label="Breadcrumb" style="padding-top:24px">
      <ol><li><a href={lang === 'ar' ? '/ar/' : '/'}>{L.home}</a></li><li><a href={`${p}/lessons/`}>{L.all}</a></li><li aria-current="page">{fill(L.n, { n: d.number })}</li></ol>
    </nav>
    <span class="lesson-pat" aria-hidden="true"></span>
    <header class="lesson-hero">
      <p class="topic-banner"><Icon name={topicIcon(d.topic)} /><span>{d.topic}</span><span aria-hidden="true">·</span><span>{fill(L.n, { n: d.number })}</span></p>
      <h1 id="lesson-title" class="lesson-title">{d.title}</h1>
      <p class="lede">{d.lede}</p>
      <ul class="lesson-meta" role="list"><li>{L.level}: {d.level}</li><li>{fill(L.read, { n: d.minutes })}</li><li>{L.updated}: <time datetime={d.updated}>{formatDate(d.updated, lang)}</time></li></ul>
    </header>
    <div class="lesson-layout">
      <aside class="lesson-aside">
        <nav class="toc" aria-labelledby="toc-title">
          <p id="toc-title" class="small-title">{L.toc}</p>
          <ol role="list">{d.toc.map((x: any) => <li><a href={`#${x.id}`}>{x.label}</a></li>)}</ol>
        </nav>
        <div class="text-size" role="group" aria-label={L.textSize}>
          <span class="text-size__label">{L.textSize}</span>
          {L.sizes.map((s, k) => <button type="button" data-size={['s', 'm', 'l'][k]} aria-label={s} aria-pressed={k === 1 ? 'true' : 'false'}><span aria-hidden="true" style={`font-size:${[0.8, 1, 1.22][k]}rem`}>A</span></button>)}
        </div>
        <p class="time-left mono" id="time-left" data-left={R.left} data-end={R.end} data-min={d.minutes}>{fill(R.left, { n: d.minutes })}</p>
        <button type="button" class="done-toggle" aria-pressed="false" data-done={L.done} data-is={L.isDone} set:html={doneBtn}></button>
      </aside>
      <div class="lesson-body" data-copy={L.copy} data-copied={L.copiedBtn} data-copied-sr={L.copiedSr}>
        {/* Lesson bodies are HTML, inserted exactly as written (no Markdown processing). */}
        <Fragment set:html={entry.body} />
        <div class="lesson-end">
          <button type="button" class="done-toggle" aria-pressed="false" data-done={L.done} data-is={L.isDone} set:html={doneBtn}></button>
          <section class="share" aria-labelledby="share-h">
            <h2 id="share-h" class="small-title">{L.shareH}</h2>
            <p>{L.shareP}</p>
            <ul role="list">
              {share.map(([n, h]) => <li><a class="btn btn--quiet btn--sm" href={h} target="_blank" rel="noopener noreferrer">{n}</a></li>)}
              <li><button type="button" class="btn btn--quiet btn--sm" id="copy-link" data-done={L.linkCopied} data-url={url}>{L.copyLink}</button></li>
            </ul>
            <p class="visually-hidden" role="status" id="link-status"></p>
          </section>
          <nav class="pager" aria-label={L.all}>
            {prev && <a class="pager__link pager__link--prev" href={`${p}/lessons/${prev.slug}/`} rel="prev"><span class="pager__dir">{L.prev}</span><span class="pager__title">{fill(L.n, { n: prev.number })}: {prev.title}</span></a>}
            {next && <a class="pager__link pager__link--next" href={`${p}/lessons/${next.slug}/`} rel="next"><span class="pager__dir">{L.next}</span><span class="pager__title">{fill(L.n, { n: next.number })}: {next.title}</span></a>}
          </nav>
          <section class="related" aria-labelledby="related-h">
            <h2 id="related-h" class="related__h">{L.related}</h2>
            <ul class="related__list" role="list">{related.map(l => (
              <li><a href={`${p}/lessons/${l.data.slug}/`}>
                <span class="related__icon" aria-hidden="true"><Icon name={topicIcon(l.data.topic)} /></span>
                <span class="related__t">{l.data.title}</span>
                <span class="related__m">{fill(L.n, { n: l.data.number })} · {fill(L.read, { n: l.data.minutes })}</span>
                <Icon name="arrow-right" class="related__go icon-flip" />
              </a></li>))}</ul>
          </section>
        </div>
      </div>
    </div>
  </article>
  <button type="button" class="resume-pill" id="resume" hidden data-t={R.back}>
    <Icon name="arrow-down" /><span></span>
  </button>
  <LessonPromptTools lang={lang} slug={d.slug} title={d.title} />
  <TermPops lang={lang} />
  <TocSheet lang={lang} toc={d.toc} />
  <Listen lang={lang} />
  <AskSelection lang={lang} title={d.title} />
  <Newsletter lang={lang} compact />
</Base>

<script>
  import { isDone, toggleLesson } from '../domains/learning/progress';
  import { on } from '../domains/shared/events';
  import { lastPlace, savePlace, readFraction, scrollForFraction } from '../domains/learning/resume';
  import { textWithBlanks } from '../domains/prompts/blanks';
  const art = document.querySelector<HTMLElement>('article.lesson')!;
  const slug = art.dataset.slug!;
  const body = document.querySelector<HTMLElement>('.lesson-body')!;

  // Mark as done: both buttons stay in sync. The learning domain saves it and announces it,
  // and the site layer celebrates (stars and a short message).
  const btns = [...document.querySelectorAll<HTMLButtonElement>('.done-toggle')];
  const paint = () => { const done = isDone(slug); btns.forEach(b => { b.setAttribute('aria-pressed', String(done)); b.querySelector('.done-toggle__label')!.textContent = done ? b.dataset.is! : b.dataset.done!; }); };
  btns.forEach(b => b.addEventListener('click', () => toggleLesson(slug)));
  on('learning:progress-changed', paint);
  paint();

  // Remember how far you read. Coming back later offers a jump to the same spot.
  const tl = document.getElementById('time-left')!;
  const mins = +tl.dataset.min!;
  const before = lastPlace();
  let saveT = 0;
  function onRead() {
    const f = readFraction(art);
    const left = Math.ceil(mins * (1 - f));
    tl.textContent = f > 0.97 ? tl.dataset.end! : tl.dataset.left!.replace('{n}', String(Math.max(1, left)));
    clearTimeout(saveT);
    // Only once someone has really started reading, so a quick look doesn't replace their real place.
    saveT = window.setTimeout(() => { if (f > 0.04 || before?.slug === slug) savePlace(slug, f); }, 400);
  }
  addEventListener('scroll', onRead, { passive: true });
  const pill = document.getElementById('resume') as HTMLButtonElement;
  if (before && before.slug === slug && before.pct > 0.08 && before.pct < 0.95 && !location.hash) {
    pill.querySelector('span')!.textContent = pill.dataset.t!.replace('{p}', String(Math.round(before.pct * 100)));
    pill.hidden = false;
    const hide = () => { pill.classList.add('is-gone'); setTimeout(() => (pill.hidden = true), 400); removeEventListener('scroll', far); };
    // Hide the offer once the reader scrolls a good way on their own, or after 12 seconds.
    const far = () => { if (scrollY > innerHeight * 1.5) hide(); };
    addEventListener('scroll', far, { passive: true });
    setTimeout(hide, 12000);
    pill.addEventListener('click', () => { scrollTo({ top: scrollForFraction(art, before.pct), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); hide(); });
  }
  onRead();

  // Text size for reading: remembered on this device, applied before paint by the head script in Base.
  const sizeBtns = [...document.querySelectorAll<HTMLButtonElement>('.text-size button')];
  const paintSize = () => { const v = document.documentElement.dataset.text || 'm'; sizeBtns.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.size === v))); };
  sizeBtns.forEach(b => b.addEventListener('click', () => {
    document.documentElement.dataset.text = b.dataset.size!;
    try { localStorage.setItem('ahl:text', b.dataset.size!); } catch (e) {}
    paintSize();
  }));
  paintSize();

  // Copy buttons on prompt cards and "better prompt" boxes.
  async function copy(text: string) {
    try { await navigator.clipboard.writeText(text); return true; }
    catch (e) { const ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0'; document.body.appendChild(ta); ta.select(); let ok = false; try { ok = document.execCommand('copy'); } catch (_) {} ta.remove(); return ok; }
  }
  body.addEventListener('click', async e => {
    const b = (e.target as Element).closest<HTMLButtonElement>('.copy-btn');
    if (!b) return;
    const box = b.closest('.sheet, .compare__col');
    const src = box?.querySelector('.sheet__text, .compare__text');
    // Filled-in blanks are copied with what was typed; empty ones keep their [name].
    if (!src || !(await copy(textWithBlanks(src)))) return;
    const label = [...b.childNodes].find(n => n.nodeType === 3 && n.textContent!.trim());
    if (label) { label.textContent = body.dataset.copied!; setTimeout(() => (label.textContent = body.dataset.copy!), 1600); }
    b.classList.add('is-copied'); setTimeout(() => b.classList.remove('is-copied'), 1600);
    box!.classList.remove('swept'); void (box as HTMLElement).offsetWidth; box!.classList.add('swept');
    const st = box!.querySelector('.copy-status'); if (st) st.textContent = body.dataset.copiedSr!;
  });

  // Copy the page link.
  const cl = document.getElementById('copy-link') as HTMLButtonElement;
  cl.addEventListener('click', async () => { if (await copy(cl.dataset.url!)) document.getElementById('link-status')!.textContent = cl.dataset.done!; const t = cl.textContent; cl.textContent = cl.dataset.done!; setTimeout(() => (cl.textContent = t), 1600); });

  // Highlight the section you're reading in "On this page".
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const secs = links.map(a => document.getElementById(a.hash.slice(1))).filter(Boolean) as HTMLElement[];
  const io = new IntersectionObserver(es => {
    es.forEach(en => { if (en.isIntersecting) links.forEach(a => a.setAttribute('aria-current', String(a.hash === '#' + en.target.id))); });
  }, { rootMargin: '-20% 0px -70% 0px' });
  secs.forEach(s => io.observe(s));
</script>
<style is:global>
  /* A band of light sweeps across a prompt card when you copy it. */
  .sheet,.compare__col{position:relative;overflow:hidden}
  .motion .swept::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(100deg,transparent 30%,rgb(242 163 58 / .28) 50%,transparent 70%);animation:card-sweep .9s ease-out both}
  @keyframes card-sweep{from{transform:translateX(-100%)}to{transform:translateX(100%)}}
  [dir=rtl] .motion .swept::after{animation-direction:reverse}
  /* Sections rise in as you read */
  .motion-ready .lesson-body>section:not(.is-in),.motion-ready .lesson-body>figure:not(.is-in){opacity:0;transform:translateY(24px)}
  .motion .lesson-body>section,.motion .lesson-body>figure{transition:opacity .8s var(--ease-out),transform .8s var(--ease-out)}
  .motion .lesson-h2::before{transform-origin:var(--start,left);transform:scaleX(0);transition:transform .9s var(--ease-out) .2s}
  .motion .is-in .lesson-h2::before,.lesson-h2::before{transform:scaleX(1)}
  .motion-ready .lesson-section:not(.is-in) .lesson-h2::before{transform:scaleX(0)}
  .done-toggle[aria-pressed=true] .done-toggle__box{animation:done-pop .55s var(--ease-spring)}
  .text-size{display:flex;align-items:center;gap:4px;padding:0 4px}
  .text-size__label{font-size:.82rem;color:var(--text-2);margin-inline-end:auto}
  .text-size button{width:38px;height:34px;border-radius:8px;border:1px solid var(--line);background:transparent;color:var(--text-2);cursor:pointer;display:grid;place-items:center;font-family:var(--display);font-weight:600;line-height:1}
  .text-size button[aria-pressed=true]{border-color:var(--accent);color:var(--text);background:var(--accent-soft)}
  .related{display:grid;gap:14px;margin-top:8px}
  .related__h{font-size:1.5rem}
  .related__list{list-style:none;margin:0;padding:0;display:grid;gap:10px}
  .related__list a{display:grid;grid-template-columns:auto minmax(0,1fr) auto;grid-template-areas:"i t g" "i m g";column-gap:14px;row-gap:2px;align-items:center;padding:14px 16px;border-radius:var(--radius);border:1px solid var(--line);background:var(--surface);text-decoration:none;color:var(--text);transition:border-color .2s,transform var(--spring-fast,.4s) var(--spring,ease)}
  .related__list a:hover{border-color:var(--accent);transform:translateY(-2px)}
  .related__icon{grid-area:i;width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:var(--accent-soft);color:var(--accent-text)}
  .related__icon svg{width:22px;height:22px}
  .related__t{grid-area:t;font:600 1.08rem/1.35 var(--display)}
  .related__m{grid-area:m;font-size:.85rem;color:var(--text-2)}
  .related__go{grid-area:g;width:20px;height:20px;color:var(--accent-text)}
  .time-left{margin:0;padding:0 4px;font-size:.82rem;color:var(--text-2)}
  .resume-pill{position:fixed;z-index:40;bottom:max(20px,env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);display:inline-flex;align-items:center;gap:8px;min-height:46px;padding:0 18px;border-radius:999px;border:1px solid var(--accent);color:var(--text);font:inherit;font-weight:600;cursor:pointer;transition:opacity .35s,transform var(--spring-t) var(--spring);max-width:calc(100vw - 150px)}
  .resume-pill svg{width:18px;height:18px;color:var(--accent-text);flex:none}
  .resume-pill.is-gone{opacity:0;transform:translate(-50%,16px)}
  .motion .resume-pill:not([hidden]){animation:pill-in .5s var(--ease-spring) .6s both}
  @keyframes pill-in{from{opacity:0;transform:translate(-50%,24px)}}
  @keyframes done-pop{0%{transform:scale(.5)}60%{transform:scale(1.25)}100%{transform:none}}
</style>
