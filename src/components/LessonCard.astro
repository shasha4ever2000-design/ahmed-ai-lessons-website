---
import Icon from './Icon.astro';
import { topicIcon } from '../topicIcons';
import { T, fill, pre, type Lang } from '../i18n';
interface Props { lesson: any; lang: Lang; heading?: 'h2' | 'h3' }
const { lesson, lang, heading = 'h3' } = Astro.props;
const d = lesson.data;
const t = T[lang];
const H = heading;
---
<article class="card lesson-card" data-slug={d.slug} data-topic={d.topic} data-track={d.track} data-tilt>
  <span class="card__pat" aria-hidden="true"></span>
  <span class="card__num" aria-hidden="true">{String(d.number).padStart(2, '0')}</span>
  <span class="card__topic"><Icon name={topicIcon(d.topic)} />{d.topic}</span>
  <H><a href={`${pre(lang)}/lessons/${d.slug}/`}>{d.title}</a></H>
  <p>{d.summary}</p>
  <p class="card__meta"><span>{fill(t.lesson.n, { n: d.number })}</span><span>{fill(t.lesson.read, { n: d.minutes })}</span><span>{d.level}</span></p>
  <span class="card__done" hidden role="img" aria-label={t.lesson.isDone}><Icon name="check" weight="bold" /></span>
</article>
