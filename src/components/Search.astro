---
// Site search: a header button and a dialog. Opens with the button, "/" or Ctrl/Cmd+K.
// The index (built by src/pages/search/[lang].json.ts) loads the first time search opens.
import { T, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const S = T[lang].search;
---
<button class="search-btn" type="button" id="search-open" aria-haspopup="dialog" aria-label={S.label} hidden>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
  <span class="search-btn__label">{S.open}</span><kbd class="search-btn__key" aria-hidden="true">/</kbd>
</button>
<dialog class="search" id="search" aria-labelledby="search-title" data-lang={lang}
  data-kinds={JSON.stringify(S.kinds)} data-none={S.none} data-results={S.count}>
  <div class="search__box">
    <h2 id="search-title" class="visually-hidden">{S.label}</h2>
    <div class="search__field">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="search-q" type="search" role="combobox" aria-expanded="false" aria-controls="search-list" aria-autocomplete="list"
        placeholder={S.placeholder} aria-label={S.label} autocomplete="off" spellcheck="false" enterkeyhint="go" />
      <button class="search__close" type="button" id="search-close" aria-label={T[lang].close}>Esc</button>
    </div>
    <div class="search__body">
      <div class="search__sugg" id="search-sugg">
        <p class="small-title">{S.suggested}</p>
        <div class="search__chips" id="search-chips">
          <a class="chip search__continue" id="search-continue" hidden href="#"></a>
          {S.sugg.map(([l, h]) => <a class="chip" href={h}>{l}</a>)}
        </div>
      </div>
      <ul class="search__list" id="search-list" role="listbox" aria-label={S.label} tabindex="-1" hidden></ul>
      <p class="search__status" id="search-status" role="status" aria-live="polite"></p>
    </div>
    <p class="search__keys" aria-hidden="true">{S.keys}</p>
  </div>
</dialog>

<script>
  import { loadIndex, rank, snippet, type Entry } from '../domains/search/engine';
  import { toContinue } from '../domains/learning/resume';

  const dlg = document.getElementById('search') as HTMLDialogElement;
  const q = document.getElementById('search-q') as HTMLInputElement;
  const list = document.getElementById('search-list')!;
  const status = document.getElementById('search-status')!;
  const sugg = document.getElementById('search-sugg')!;
  const opener = document.getElementById('search-open')!;
  const lang = dlg.dataset.lang!;
  const kinds = JSON.parse(dlg.dataset.kinds!) as Record<string, string>;
  let results: Entry[] = [], active = -1, last: Element | null = null;

  const esc = (s: string) => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  // A lesson you started shows first in the suggestions. Its title comes from the index.
  async function showContinue() {
    const c = toContinue(), a = document.getElementById('search-continue') as HTMLAnchorElement;
    if (!c) { a.hidden = true; return; }
    const idx = await loadIndex(lang);
    const e = idx.find(x => x.k === 'lesson' && x.u.endsWith(`/lessons/${c.slug}/`));
    if (!e) return;
    a.href = e.u; a.textContent = '↻ ' + e.t; a.hidden = false;
  }

  function open() {
    if (dlg.open) return;
    last = document.activeElement;
    dlg.showModal();
    q.focus(); q.select();
    loadIndex(lang); showContinue();
    if (q.value) search();
  }
  function close() { dlg.close(); }
  dlg.addEventListener('close', () => { if (last instanceof HTMLElement) last.focus(); });
  // Click on the dimmed backdrop closes; clicks inside the box don't.
  dlg.addEventListener('click', e => { if (e.target === dlg) close(); });
  // Search needs JavaScript, so its button only appears once this script runs.
  opener.hidden = false;
  opener.addEventListener('click', open);
  document.getElementById('search-close')!.addEventListener('click', close);
  document.addEventListener('keydown', e => {
    const el = e.target as HTMLElement;
    // The search box itself only counts as "typing" while search is open (it keeps focus for a moment after closing).
    const typing = (el !== q || dlg.open) && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName));
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) { e.preventDefault(); dlg.open ? close() : open(); }
  });

  function paint() {
    list.innerHTML = results.map((r, i) => `<li role="option" id="sr-${i}" aria-selected="${i === active}" class="search__item">
      <span class="search__kind search__kind--${r.k}">${esc(kinds[r.k] || '')}</span>
      <span class="search__t">${esc(r.t)}</span><span class="search__s">${esc(snippet(r, q.value))}</span></li>`).join('');
    q.setAttribute('aria-activedescendant', active >= 0 ? `sr-${active}` : '');
    if (active >= 0) document.getElementById(`sr-${active}`)?.scrollIntoView({ block: 'nearest' });
  }

  let token = 0;
  async function search() {
    const v = q.value.trim(), my = ++token;
    if (!v) { results = []; list.hidden = true; sugg.hidden = false; status.textContent = ''; q.setAttribute('aria-expanded', 'false'); return; }
    const idx = await loadIndex(lang);
    if (my !== token) return;
    results = rank(idx, v);
    active = results.length ? 0 : -1;
    sugg.hidden = true; list.hidden = !results.length;
    q.setAttribute('aria-expanded', String(!!results.length));
    status.textContent = results.length ? dlg.dataset.results!.replace('{n}', String(results.length)) : dlg.dataset.none!.replace('{q}', v);
    status.classList.toggle('is-empty', !results.length);
    paint();
  }
  q.addEventListener('input', search);
  q.addEventListener('keydown', e => {
    // A search box would use Esc to clear itself first; here Esc always closes.
    if (e.key === 'Escape') { e.preventDefault(); close(); return; }
    if (!results.length) return;
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      active = (active + (e.key === 'ArrowDown' ? 1 : -1) + results.length) % results.length;
      paint();
    } else if (e.key === 'Enter' && active >= 0) {
      e.preventDefault();
      go(results[active].u);
    }
  });
  list.addEventListener('mousemove', e => {
    const li = (e.target as Element).closest('li'); if (!li) return;
    const i = +li.id.slice(3); if (i !== active) { active = i; paint(); }
  });
  function go(u: string) {
    // Same-page anchors (like a glossary term) need the dialog closed before the jump.
    close();
    location.href = u;
  }
  list.addEventListener('click', e => {
    const li = (e.target as Element).closest('li'); if (!li) return;
    go(results[+li.id.slice(3)].u);
  });
</script>

<style is:global>
  .search-btn[hidden]{display:none}
  .search-btn{display:inline-flex;align-items:center;gap:8px;height:42px;padding:0 10px 0 12px;border-radius:999px;border:1px solid var(--line-2);background:transparent;color:var(--text-2);cursor:pointer;font:inherit;font-size:.9rem}
  .search-btn:hover{border-color:var(--accent);color:var(--text)}
  .search-btn svg{width:18px;height:18px}
  .search-btn__key{font:500 .75rem var(--mono);border:1px solid var(--line-2);border-radius:6px;padding:1px 6px;color:var(--text-2)}
  @media (max-width:1480px){.search-btn{width:42px;padding:0;justify-content:center}.search-btn__label,.search-btn__key{display:none}}

  .search{padding:0;border:0;background:transparent;width:min(680px,calc(100vw - 24px));max-height:none;margin:min(12vh,96px) auto auto;color:var(--text);overflow:visible}
  .search::backdrop{background:rgb(10 7 5 / .62);backdrop-filter:blur(3px)}
  .search__box{border:1px solid var(--line-2);border-radius:18px;box-shadow:0 30px 80px rgb(0 0 0 / .45);overflow:hidden;display:flex;flex-direction:column;max-height:min(72vh,640px)}
  .search__field{display:flex;align-items:center;gap:10px;padding:0 14px;border-bottom:1px solid var(--line)}
  .search__field svg{width:20px;height:20px;color:var(--accent-text);flex:none}
  .search__field input{flex:1;min-width:0;height:60px;border:0;background:transparent;color:var(--text);font:inherit;font-size:1.1rem;outline:none}
  .search__field input::-webkit-search-cancel-button{display:none}
  .search__close{font:500 .75rem var(--mono);border:1px solid var(--line-2);border-radius:8px;background:transparent;color:var(--text-2);padding:4px 8px;cursor:pointer}
  .search__body{display:flex;flex-direction:column;flex:1 1 auto;min-height:0;padding:12px}
  .search__sugg{padding:6px 6px 10px}
  .search__chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
  .search__chips .chip{display:inline-flex;align-items:center;text-decoration:none;color:var(--text)}
  .search__continue{background:var(--accent-soft);border-color:color-mix(in srgb,var(--accent) 50%,var(--line))}
  .search__list{list-style:none;margin:0;padding:0;display:grid;gap:4px;overflow:auto;overscroll-behavior:contain;min-height:0}
  .search__list:focus{outline:none}
  .search__item{cursor:pointer}
  .search__item{display:grid;grid-template-columns:auto minmax(0,1fr);column-gap:12px;row-gap:2px;padding:10px 12px;border-radius:12px;text-decoration:none;color:inherit;border:1px solid transparent}
  .search__item[aria-selected=true]{background:var(--surface-2);border-color:var(--line-2)}
  .search__kind{grid-row:span 2;align-self:start;margin-top:2px;font:500 .7rem var(--mono);text-transform:uppercase;letter-spacing:.04em;padding:3px 7px;border-radius:6px;background:var(--surface-2);color:var(--text-2);white-space:nowrap}
  /* Arabic letters join, so no spacing between them and the reading font instead of the code font. */
  [dir=rtl] .search__kind{font:600 .75rem var(--body);letter-spacing:0}
  .search__kind--lesson,.search__kind--section{background:var(--accent-soft);color:var(--accent-text)}
  .search__t{font-weight:600}
  .search__s{color:var(--text-2);font-size:.9rem;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
  .search__status{margin:6px;color:var(--text-2);font-size:.9rem}
  .search__status:not(.is-empty){position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  .search__keys{margin:0;padding:10px 16px;border-top:1px solid var(--line);font:500 .75rem var(--mono);color:var(--text-2)}
  @media (max-width:600px){.search{margin-top:10px}.search__keys{display:none}.search__box{max-height:calc(100dvh - 24px)}}
</style>
