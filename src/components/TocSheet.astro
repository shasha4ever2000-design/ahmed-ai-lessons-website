---
// On phones the lesson's "On this page" list scrolls away with the top of the page.
// This floating button brings it back as a sheet from the bottom of the screen.
import { T, type Lang } from '../i18n';
interface Props { lang: Lang; toc: { id: string; label: string }[] }
const { lang, toc } = Astro.props;
const label = T[lang].tocFab;
---
<button type="button" class="toc-fab" id="toc-fab" popovertarget="toc-sheet" aria-label={label} hidden>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"/></svg>
</button>
<nav class="toc toc--sheet" id="toc-sheet" popover aria-labelledby="toc-sheet-title">
  <p id="toc-sheet-title" class="small-title">{label}</p>
  <ol role="list">{toc.map(x => <li><a href={`#${x.id}`}>{x.label}</a></li>)}</ol>
  <p class="toc-sheet__left mono" aria-hidden="true"></p>
</nav>

<script>
  const fab = document.getElementById('toc-fab') as HTMLButtonElement;
  const sheet = document.getElementById('toc-sheet') as HTMLElement & { hidePopover?: () => void };
  const asideToc = document.querySelector('.lesson-aside .toc');
  if (sheet.hidePopover && asideToc) {
    const narrow = matchMedia('(max-width: 900px)');
    let past = false;
    const show = () => { fab.hidden = !(narrow.matches && past); if (fab.hidden && sheet.matches(':popover-open')) sheet.hidePopover!(); };
    // The button appears once the page's own list has scrolled out of view.
    new IntersectionObserver(([e]) => { past = !e.isIntersecting && e.boundingClientRect.top < 0; show(); }).observe(asideToc);
    narrow.addEventListener('change', show);
    sheet.addEventListener('click', e => { if ((e.target as Element).closest('a')) sheet.hidePopover!(); });
    // Show the same "minutes left" line as the sidebar.
    sheet.addEventListener('toggle', (e: any) => { if (e.newState === 'open') sheet.querySelector('.toc-sheet__left')!.textContent = document.getElementById('time-left')?.textContent || ''; });
  }
</script>

<style is:global>
  .toc-fab{position:fixed;z-index:40;bottom:max(20px,env(safe-area-inset-bottom));inset-inline-start:16px;width:52px;height:52px;border-radius:999px;border:1px solid var(--line-2);background:var(--surface);color:var(--text);display:grid;place-items:center;box-shadow:0 10px 30px rgb(0 0 0 / .3);cursor:pointer}
  .toc-fab[hidden]{display:none}
  .toc-fab svg{width:22px;height:22px}
  .motion .toc-fab:not([hidden]){animation:fab-in .4s var(--ease-spring)}
  @keyframes fab-in{from{opacity:0;transform:scale(.6)}}
  .toc--sheet{position:fixed;inset:auto 0 0 0;margin:0;width:100%;max-height:70dvh;overflow:auto;border-radius:20px 20px 0 0;border:1px solid var(--line-2);border-bottom:0;padding:20px 20px max(20px,env(safe-area-inset-bottom));background:var(--surface);color:var(--text);box-shadow:0 -20px 60px rgb(0 0 0 / .35)}
  .toc--sheet::backdrop{background:rgb(10 7 5 / .5)}
  .toc--sheet ol{margin-top:10px}
  .toc--sheet a{padding:10px 12px;font-size:1rem}
  .toc-sheet__left{margin:12px 4px 0;font-size:.85rem;color:var(--text-2)}
  .motion .toc--sheet:popover-open{animation:sheet-up .3s var(--ease-out)}
  @keyframes sheet-up{from{transform:translateY(40%);opacity:0}}
  @media print{.toc-fab,.toc--sheet{display:none!important}}
</style>
