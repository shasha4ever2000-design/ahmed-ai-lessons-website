---
import '../styles/global.css';
import '../styles/motion.css';
import { T, SITE, otherPath, SOCIALS, type Lang } from '../i18n';
import Search from '../components/Search.astro';

interface Props {
  lang: Lang;
  title: string;          // full <title>
  description: string;
  path: string;           // this page's path, e.g. "/lessons/x/"
  ogImage?: string;       // path under the site, e.g. "/media/og/en-home.jpg"
  ogType?: string;
  jsonld?: object[];
  noAlternate?: boolean;  // pages that exist in one language only
  intro?: boolean;        // opening shutters (homepage)
  readBar?: boolean;      // reading progress strip (lesson pages)
}
const { lang, title, description, path, ogImage = `/media/og/${lang}-home.jpg`, ogType = 'website', jsonld = [], noAlternate = false, intro = false, readBar = false } = Astro.props;
const t = T[lang];
const url = SITE + path;
// Pages with one language (like 404) switch to the other language's homepage.
const other = noAlternate ? (lang === 'en' ? '/ar/' : '/') : otherPath(path, lang);
const enPath = lang === 'en' ? path : other;
const arPath = lang === 'ar' ? path : other;
const current = Astro.url.pathname;
const ICONS: Record<string, string> = {
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>',
  linkedin: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/>',
  facebook: '<rect x="3" y="3" width="18" height="18" rx="4"/><path d="M15.5 8.5H14a2 2 0 0 0-2 2V21M9.5 13h5"/>',
  whatsapp: '<path d="M3.5 20.5l1.3-4.1A8.5 8.5 0 1 1 8 19.5z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 .8a5 5 0 0 1-2.8-2.8l.8-1-1-2z" fill="currentColor" stroke="none"/>',
};
---
<!doctype html>
<html lang={lang} dir={t.dir} data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <script is:inline>(function(){var s=null;try{s=localStorage.getItem('ahl:theme')}catch(e){}document.documentElement.dataset.theme=s==='light'?'light':'dark'})()</script>
  <script is:inline define:vars={{ intro }}>
    // Motion is on unless the visitor asked for less. The homepage shutters play once per visit.
    (function (r) {
      var still = false; try { still = matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
      if (still) return;
      r.classList.add('motion');
      if (intro) { var seen = null; try { seen = sessionStorage.getItem('ahl:intro'); sessionStorage.setItem('ahl:intro', '1'); } catch (e) {} if (!seen) r.classList.add('intro'); }
    })(document.documentElement);
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#16100c" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="192x192" href="/media/icon-192.png" />
  <link rel="apple-touch-icon" href="/media/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="canonical" href={url} />
  {!noAlternate && <link rel="alternate" hreflang="en" href={SITE + enPath} />}
  {!noAlternate && <link rel="alternate" hreflang="ar" href={SITE + arPath} />}
  {!noAlternate && <link rel="alternate" hreflang="x-default" href={SITE + enPath} />}
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={t.siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={SITE + ogImage} />
  <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" as="font" type="font/woff2" href={lang === 'ar' ? '/assets/el-messiri-arabic-var.woff2' : '/assets/el-messiri-latin-var.woff2'} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={lang === 'ar' ? '/assets/ibm-plex-sans-arabic-arabic-400-normal-DqElNKgb.woff2' : '/assets/ibm-plex-sans-arabic-latin-400-normal-Bo5KPYvw.woff2'} crossorigin />
  {jsonld.map(j => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  <script defer is:inline src="/_vercel/insights/script.js"></script>
  <slot name="head" />
</head>
<body>
  {intro && <div class="shutters" aria-hidden="true"><div class="shutters__panel shutters__panel--a"></div><div class="shutters__panel shutters__panel--b"></div></div>}
  <a class="skip" href="#main">{t.skip}</a>
  <header class="site-head">
    <div class="wrap">
      <a class="brand" href={lang === 'ar' ? '/ar/' : '/'}>
        <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 2.5l3.3 5.4 6.2-1.4-1.4 6.2 5.4 3.3-5.4 3.3 1.4 6.2-6.2-1.4L16 29.5l-3.3-5.4-6.2 1.4 1.4-6.2L2.5 16l5.4-3.3-1.4-6.2 6.2 1.4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="16" cy="16" r="4" fill="currentColor"/></svg>
        <span><span class="brand__name">{t.name}</span><span class="brand__tag">{t.brandTag}</span></span>
      </a>
      <nav aria-label={t.mainNav}>
        <ul class="nav-links" role="list">
          {t.nav.map(([label, href]) => <li><a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a></li>)}
        </ul>
      </nav>
      <div class="head-end">
        <Search lang={lang} />
        <a class="lang-link" href={other} hreflang={lang === 'en' ? 'ar' : 'en'} lang={lang === 'en' ? 'ar' : 'en'} aria-label={t.langSwitchLabel}>{t.langSwitch}</a>
        <button class="icon-btn" type="button" id="theme-btn" data-l={t.themeLight} data-d={t.themeDark} aria-label={t.themeLight}>
          <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
          <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <a class="btn btn--accent" href={(lang === 'ar' ? '/ar/' : '/') + '#newsletter'}>{t.weekly}</a>
        <button class="icon-btn menu-btn" type="button" id="menu-btn" aria-expanded="false" aria-controls="mobile-nav" aria-label={t.menu} data-open={t.menu} data-close={t.close}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </div>
    <nav class="mobile-nav" id="mobile-nav" aria-label={t.mainNav} hidden>
      <ul role="list">{t.nav.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
      <a class="btn btn--accent" href={(lang === 'ar' ? '/ar/' : '/') + '#newsletter'}>{t.weekly}</a>
    </nav>
  </header>

  {readBar && <div class="read-bar" aria-hidden="true"></div>}
  <main id="main" tabindex="-1"><slot /></main>

  <footer class="site-foot">
    <div class="wrap">
      <div class="foot-grid">
        <div>
          <p class="brand__name">{t.name}</p>
          <p class="foot-tag">{t.foot.tag}</p>
          <p class="foot-tag">{t.foot.follow}</p>
          <div class="socials">
            {SOCIALS.map(s => <a class="social" href={s.href} target="_blank" rel="noopener me" aria-label={s.label}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[s.id]} /></a>)}
          </div>
        </div>
        <div><h2>{t.foot.learn}</h2><ul role="list">{t.foot.links.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul></div>
        <div><h2>{t.foot.site}</h2><ul role="list">{t.foot.links2.map(([l, h]) => <li><a href={h}>{l}</a></li>)}<li><a href={other} lang={lang === 'en' ? 'ar' : 'en'}>{t.langSwitch}</a></li></ul></div>
      </div>
      <div class="foot-legal"><span>{t.foot.legal}</span><span>© 2026 {t.name} · <a href="#main">{t.foot.top}</a></span></div>
    </div>
  </footer>

  <script>
    import '../scripts/site.ts';
    document.documentElement.classList.add('motion-ready');
    // Theme: dark cedar by default, plaster when the visitor picks light. Shared with the tool pages (ahl:theme).
    const root = document.documentElement;
    const tb = document.getElementById('theme-btn')!;
    const label = () => tb.setAttribute('aria-label', root.dataset.theme === 'dark' ? tb.dataset.l! : tb.dataset.d!);
    label();
    tb.addEventListener('click', () => {
      root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      try { localStorage.setItem('ahl:theme', root.dataset.theme); } catch (e) {}
      label();
      window.dispatchEvent(new CustomEvent('ahl:theme', { detail: root.dataset.theme }));
    });
    // Mobile menu
    const mb = document.getElementById('menu-btn')!, mn = document.getElementById('mobile-nav')!;
    const setMenu = (open: boolean) => { mn.hidden = !open; mb.setAttribute('aria-expanded', String(open)); mb.setAttribute('aria-label', open ? mb.dataset.close! : mb.dataset.open!); document.body.style.overflow = open ? 'hidden' : ''; };
    mb.addEventListener('click', () => setMenu(mn.hidden));
    mn.addEventListener('click', e => { if ((e.target as Element).closest('a')) setMenu(false); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && !mn.hidden) { setMenu(false); mb.focus(); } });
    // Chat: loads its own config; live chat only loads when opened.
    const chatUrl = '/chat-widget.js';
    const startChat = () => import(/* @vite-ignore */ chatUrl).then(m => m.startChat(root.lang)).catch(() => {});
    if ('requestIdleCallback' in window) (window as any).requestIdleCallback(startChat, { timeout: 4000 }); else setTimeout(startChat, 2000);
  </script>
</body>
</html>
